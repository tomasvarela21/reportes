# Copiar este archivo como .env en la raíz del proyecto (mismo nivel que Home.py)
# El .env ya debería existir con DATABASE_URL para Streamlit — solo agregar las líneas nuevas

# ── Base de datos (Neon PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Backend API ───────────────────────────────────────────────────────────────
# Clave para autenticar requests al backend (header X-API-Key)
API_KEY=changeme-generá-un-valor-seguro

# Orígenes permitidos para CORS (separados por coma si usás múltiples)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Power BI (opcional) ───────────────────────────────────────────────────────
# Si estas variables no están definidas, POST /api/v1/powerbi/refresh devuelve 503.
# Autenticación ROPC (Resource Owner Password Credentials).
#
# POWERBI_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# POWERBI_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# POWERBI_CLIENT_SECRET=tu-client-secret
# POWERBI_USERNAME=usuario@dominio.com
# POWERBI_PASSWORD=tu-password
# POWERBI_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
